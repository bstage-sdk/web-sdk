{
  "name": "@bstage-sdk/host",
  "version": "0.1.0",
  "description": "bstage SDK host — load and manage template bundles on the platform side",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/bstage-sdk/web-sdk.git",
    "directory": "packages/host"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bstage-sdk/core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  },
  "license": "MIT"
}
