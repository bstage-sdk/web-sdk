{
  "name": "@bstage-sdk/design",
  "version": "0.1.0",
  "description": "bstage 디자인 토큰 SDK — 커스텀 템플릿을 bstage 디자인 시스템에 맞춘다",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/bstage-sdk/web-sdk.git",
    "directory": "packages/design"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./user": {
      "import": {
        "types": "./dist/user/index.d.ts",
        "default": "./dist/user/index.js"
      },
      "require": {
        "types": "./dist/user/index.d.cts",
        "default": "./dist/user/index.cjs"
      }
    },
    "./admin": {
      "import": {
        "types": "./dist/admin/index.d.ts",
        "default": "./dist/admin/index.js"
      },
      "require": {
        "types": "./dist/admin/index.d.cts",
        "default": "./dist/admin/index.cjs"
      }
    },
    "./css/user.css": "./css/user.css",
    "./css/admin.css": "./css/admin.css"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "user": [
        "./dist/user/index.d.ts"
      ],
      "admin": [
        "./dist/admin/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "css"
  ],
  "scripts": {
    "build": "tsup && node scripts/build-css.mjs",
    "build:css": "node scripts/build-css.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  },
  "license": "MIT"
}
