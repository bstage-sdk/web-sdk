{
  "name": "bstage-sdk",
  "private": true,
  "type": "module",
  "description": "b.stage \uc11c\ub4dc\ud30c\ud2f0 \ud15c\ud50c\ub9bf SDK",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bstage-sdk/web-sdk.git"
  },
  "scripts": {
    "build": "pnpm --filter './packages/*' run build",
    "typecheck": "pnpm --filter './packages/*' run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint packages/*/src/ --max-warnings=0",
    "format": "prettier --write 'packages/*/src/**/*.{ts,tsx}'",
    "format:check": "prettier --check 'packages/*/src/**/*.{ts,tsx}'",
    "figures": "node scripts/gen-slot-figures.mjs",
    "check:figures": "node scripts/gen-slot-figures.mjs --check"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.4",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "typescript-eslint": "^8.57.1",
    "vitest": "^4.1.10"
  }
}
